# knfapp environment variables — copy to .env and fill in

# Backend
APP_DEBUG=0
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-another-random-string
INVITATION_EXPIRY_HOURS=168
# UPLOAD_DIR=/data/uploads  # Image upload directory (Docker: /data/uploads, local: auto-created under backend/data/uploads)

# CORS — comma-separated allowed origins. NOT optional in a deploy:
# Flask-SocketIO checks Origin on the polling handshake even for
# same-origin pages, so leaving this unset kills realtime chat while
# the rest of the app looks fine
ALLOWED_ORIGINS=https://knfapp.example.com

# DbGate admin console
# DBGATE_PASSWORD       — DbGate's own single shared login
# DBGATE_BASIC_AUTH_HASH — the ingress asks first; generate with
#                          `docker exec knfapp-caddy caddy hash-password`
#                          (compose passes it to knfapp-caddy, and the
#                          Caddyfile default is a hash nobody holds, so
#                          an unset value locks DbGate out, not open).
#                          SINGLE-QUOTE it: a bcrypt hash is full of $
#                          and compose interpolates unquoted .env values
DBGATE_PASSWORD=change-me-to-a-long-random-string
DBGATE_BASIC_AUTH_HASH='$2b$12$replace-with-the-output-of-caddy-hash-password'

# Expo — access token for the mobile dev server container
EXPO_TOKEN=change-me-to-an-expo-access-token

# Domain (for Caddy)
DOMAIN=knfapp.example.com
