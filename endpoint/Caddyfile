:80 {
    encode zstd gzip

    route {

        # Uploads: the one route that may carry a video (50 MB
        # + the multipart envelope — Flask's MAX_CONTENT_LENGTH)
        handle /api/uploads* {
            request_body {
                max_size 52MB
            }
            reverse_proxy knfapp-django:8000 {
                header_up -X-Forwarded-Prefix
            }
        }


        # API backend
        handle /api/* {
            # Oversized bodies die here instead of filling the
            # backend's /tmp tmpfs; 6 MB is more than any JSON
            # body this API takes
            request_body {
                max_size 6MB
            }
            reverse_proxy knfapp-django:8000 {
                header_up -X-Forwarded-Prefix
            }
        }


        # Socket.IO realtime chat (same Flask backend; Caddy
        # passes WebSocket upgrades through automatically)
        handle /socket.io/* {
            reverse_proxy knfapp-django:8000 {
                header_up -X-Forwarded-Prefix
            }
        }


        # Swagger UI
        handle /swagger* {
            header {
                X-Frame-Options "DENY"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
            }
            reverse_proxy knfapp-swagger:8080
        }


        # DbGate — an admin DB console on the public origin, so
        # the ingress asks for credentials before DbGate's own
        # single shared login is even reachable. The hash comes
        # from the environment (compose passes
        # DBGATE_BASIC_AUTH_HASH to knfapp-caddy, generated with
        # `caddy hash-password`); the baked-in default is the
        # bcrypt of a random password nobody holds, so an
        # unconfigured deploy fails CLOSED rather than open.
        redir /dbgate /dbgate/
        handle /dbgate/* {
            basic_auth {
                dbgate {$DBGATE_BASIC_AUTH_HASH:$2b$12$VXRCKp5Z4FWsJSAmbpjcXejgiRZoPoDT8GB3zqQdWaSsJeAinxJ5y}
            }
            reverse_proxy knfapp-dbgate:3000
        }


        # Admin panel — the administrators' web console (Vite
        # SPA, static files only). The files themselves are
        # public; every data call the panel makes goes through
        # /api/* above, where the backend checks the bearer
        # token and the admin/curator role per endpoint.
        redir /adminpanel /adminpanel/
        handle /adminpanel/* {
            header {
                X-Frame-Options "DENY"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
            }
            reverse_proxy knfapp-vite:80
        }


        # Expo web app — CSP is per-handle rather than site-wide
        # so /api/* keeps the headers Flask sets itself
        # (add_security_headers) with no duplication. Metro's
        # bundle needs inline+eval script and a same-origin
        # websocket for HMR
        handle {
            header {
                X-Frame-Options "DENY"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "strict-origin-when-cross-origin"
                Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
            }
            reverse_proxy knfapp-mobile:8081
        }
    }
}
