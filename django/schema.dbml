// ============================================================
//  knfapp — Django / SQLite schema
//
//  Every primary key is a uuid4 TEXT string minted in Python
//  (except the composite tables and the content-addressed /
//  scoped ids called out below). Timestamps are ISO-8601 TEXT:
//  most tables carry the aware "+00:00" form, the chat and
//  push tables carry NAIVE UTC (no offset) — cursors and
//  unread counts compare them as strings.
//
//  Solid arrows = real foreign keys (enforced per connection).
//  Delete behaviour lives in the APPLICATION, not in ON DELETE
//  clauses: the notes say what the app does. A user is never
//  hard-deleted — erasure anonymises the row in place, so
//  user references never dangle.
//
//  Denormalised counters (post likes/comments, poll totals)
//  are recomputed from child rows on every write, never ±1.
//  messages has an FTS5 shadow table (messages_fts, kept in
//  sync by triggers) that is not drawn here.
// ============================================================


// ------------------------------------------------------------
// Accounts & sessions (users app)
// ------------------------------------------------------------

Table users {
  id                 text  [pk, note: 'uuid4']
  username           text  [unique]
  email              text  [unique]
  display_name       text  [note: 'Snapshotted into news_posts.author_name on write; a rename rewrites the snapshots']
  password_hash      text  [note: 'bcrypt; erasure replaces it with an unreachable bcrypt-shaped hash']
  role               text  [note: 'CHECK: student / teacher / admin / curator']
  invited            int   [default: 1]
  avatar_url         text  [null, note: 'Own /api/uploads/ path or NULL']
  student_number     text  [null]
  study_group        text  [null]
  study_program      text  [null]
  active             int   [default: 1, note: '0 locks the account out on live sessions too']
  chat_push_preview  int   [default: 1, note: '0 = push shows "Nauja žinutė" instead of message text']
  created_at         text
  updated_at         text
}

Table invitation_codes {
  id          text  [pk, note: 'uuid4']
  code        text  [unique, note: '12 uppercase hex chars; privileged (admin/curator) codes are single-use, max 72 h']
  role        text  [note: 'CHECK: the role the code mints']
  created_by  text  [null, note: 'Curators may only list/revoke their OWN mintable-role codes']
  max_uses    int   [note: '1..1000 — out-of-range is rejected, never clamped']
  use_count   int   [default: 0, note: 'Burned atomically: UPDATE ... WHERE use_count < max_uses']
  expires_at  text
  created_at  text
}
Ref: invitation_codes.created_by > users.id

Table sessions {
  id          text  [pk, note: 'uuid4']
  user_id     text  [note: 'App deletes on logout-all, deactivation, erasure; trimmed to newest 10 per user']
  token       text  [unique, note: 'sha256 HEX of the bearer — the raw token is never stored']
  created_at  text
  expires_at  text  [note: '30 days; expired rows are purged lazily, push tokens with them']
}
Ref: sessions.user_id > users.id


// ------------------------------------------------------------
// Push delivery (notifications app)
// ------------------------------------------------------------

Table push_tokens {
  id          text  [pk, note: 'uuid4']
  user_id     text
  token       text  [unique, note: 'ExponentPushToken[...] — a bearer credential for that phone; logs only ever carry its sha256[:8]']
  platform    text  [default: 'unknown']
  active      int   [default: 1, note: '0 = Expo said DeviceNotRegistered; the next register flips it back']
  language    text  [default: 'lt', note: 'Routes the lt/en push copy per device']
  created_at  text  [note: 'NAIVE UTC — the historical shape of this table']
  updated_at  text
}
Ref: push_tokens.user_id > users.id

Table notification_channels {
  user_id     text  [pk, note: 'Composite PK (user_id, channel)']
  channel     text  [pk, note: 'CHECK: news / chat / schedule / admin']
  enabled     int   [note: 'OPT-OUT model: a missing row means enabled; only an explicit 0 suppresses']
  updated_at  text
}
Ref: notification_channels.user_id > users.id


// ------------------------------------------------------------
// Stored files (uploads app) — flat directory, uuid-hex names
// ------------------------------------------------------------

Table uploads {
  id          text  [pk, note: 'uuid4']
  filename    text  [unique, note: '<32 hex>.<ext> — the only shape serve/delete accept']
  user_id     text  [null, note: 'Ownership for the delete gate and the quota; erasure removes the files from disk']
  byte_size   int
  created_at  text
}
Ref: uploads.user_id > users.id


// ------------------------------------------------------------
// News — the unified feed (news app)
// ------------------------------------------------------------

Table news_posts {
  id              text  [pk, note: 'uuid4']
  title           text
  content         text
  summary         text  [null]
  image_url       text  [null, note: 'Own upload path (member posts) or an allowlisted absolute URL (scraped)']
  author_id       text  [null, note: 'NULL for scraped articles; app SET-NULLs nothing — erasure keeps the row']
  author_name     text  [null, note: 'Display-name SNAPSHOT; erasure tombstones it to "Ištrintas naudotojas"']
  source          text  [note: 'CHECK: knf.vu.lt / vu.lt / faculty / user / app — the feed score gives sources +15/+10']
  source_url      text  [unique, null, note: 'Scraper dedup key, canonical normalise_url shape']
  post_type       text  [note: 'CHECK: article / event / social']
  is_public       int   [default: 1, note: '0 = members-only; hidden and missing answer the same 404']
  likes_count     int   [default: 0, note: 'Recomputed from news_likes on every toggle']
  comments_count  int   [default: 0, note: 'Recomputed from news_comments']
  shares_count    int   [default: 0, note: 'Plain counter — shares have no child table']
  published_at    text  [note: 'NAIVE UTC for scraped rows; feed recency divides by its age']
  created_at      text
  updated_at      text
}
Ref: news_posts.author_id > users.id

Table news_likes {
  user_id     text  [pk, note: 'Composite PK (user_id, post_id) — one like per person']
  post_id     text  [pk]
  created_at  text
}
Ref: news_likes.user_id > users.id
Ref: news_likes.post_id > news_posts.id

Table news_comments {
  id          text  [pk, note: 'uuid4']
  post_id     text
  user_id     text  [note: 'Comments SURVIVE erasure — they join users at read time and pick the tombstone name up']
  text        text
  created_at  text
}
Ref: news_comments.post_id > news_posts.id
Ref: news_comments.user_id > users.id

Table polls {
  id           text  [pk, note: 'uuid4']
  post_id      text  [unique, note: 'One poll per post — a racing duplicate hits IntegrityError and answers 409']
  title        text
  end_date     text  [null, note: 'Unparseable = poll stays open (never a 500)']
  total_votes  int   [default: 0, note: 'Recomputed from poll_votes']
  created_at   text
}
Ref: polls.post_id - news_posts.id

Table poll_options {
  id        text  [pk, note: 'uuid4']
  poll_id   text
  text      text
  votes     int   [default: 0, note: 'Recomputed from poll_votes']
  position  int   [note: 'Display order; the cutover numbered it from the stored order']
}
Ref: poll_options.poll_id > polls.id

Table poll_votes {
  user_id     text  [pk, note: 'Composite PK (user_id, poll_id) — one vote per person, moved by ON CONFLICT upsert']
  poll_id     text  [pk]
  option_id   text
  created_at  text
}
Ref: poll_votes.user_id > users.id
Ref: poll_votes.poll_id > polls.id
Ref: poll_votes.option_id > poll_options.id

Table deleted_source_urls {
  source_url  text  [pk, note: 'Tombstone: an admin-deleted scraped article the scrapers must never re-insert']
  deleted_at  text
  deleted_by  text  [null]
}
Ref: deleted_source_urls.deleted_by > users.id


// ------------------------------------------------------------
// Social — friendships, walls, blocks (social app)
// Wall posts live in news_posts (source 'user'/'faculty')
// ------------------------------------------------------------

Table friendships {
  user_id     text  [pk, note: 'Composite PK (user_id, friend_id) — a friendship is TWO rows, one per direction']
  friend_id   text  [pk]
  created_at  text
}
Ref: friendships.user_id > users.id
Ref: friendships.friend_id > users.id

Table friend_requests {
  id            text  [pk, note: 'uuid4']
  from_user_id  text
  to_user_id    text
  status        text  [note: 'CHECK: pending / accepted / rejected; accept DELETES the row and writes both friendship rows']
  created_at    text
  updated_at    text  [note: 'A rejection stamp here starts the 7-day re-request cooldown']

  Note: 'PARTIAL UNIQUE (from_user_id, to_user_id) WHERE status = pending — one open request per directed pair; the loser of a race gets 409'
}
Ref: friend_requests.from_user_id > users.id
Ref: friend_requests.to_user_id > users.id

Table user_blocks {
  blocker_id  text  [pk, note: 'Composite PK (blocker_id, blocked_id) — one-directional row, bidirectional effect']
  blocked_id  text  [pk]
  created_at  text  [note: 'Placing a block severs the friendship and any pending requests in the same transaction']
}
Ref: user_blocks.blocker_id > users.id
Ref: user_blocks.blocked_id > users.id

Table reports {
  id           text  [pk, note: 'uuid4']
  reporter_id  text
  target_type  text  [note: 'CHECK: user / post / message']
  target_id    text  [note: 'POLYMORPHIC — validated against the matching table at write time, NOT an FK']
  reason       text
  status       text  [default: 'open', note: 'CHECK: open / resolved — reopening is allowed']
  created_at   text
}
Ref: reports.reporter_id > users.id

Table activity {
  id               text  [pk, note: 'uuid4']
  user_id          text  [note: 'Whose feed the row lands in']
  kind             text  [note: 'CHECK: like / comment / friend_accept / wall_post']
  actor_id         text  [note: 'Who did it']
  subject_id       text  [null, note: 'The post/comment concerned — loose ref, NOT an FK']
  subject_preview  text  [null, note: 'Frozen excerpt for the list row']
  read             int   [default: 0]
  created_at       text  [note: 'Keyset cursor: (created_at, id) descending']

  Note: 'UNIQUE (user_id, kind, actor_id, subject_id) — an unlike/redo cannot double a row; drop_activity is the undo'
}
Ref: activity.user_id > users.id
Ref: activity.actor_id > users.id


// ------------------------------------------------------------
// Chat (chat app) — NAIVE-UTC stamps throughout; two
// independent read stores (participants watermark + receipts)
// ------------------------------------------------------------

Table conversations {
  id                   text  [pk, note: 'uuid4']
  type                 text  [note: 'CHECK: direct / group. A direct pair is deduped to one room at create']
  title                text  [null, note: 'Groups only — a direct chat is always NAMED AFTER the counterpart, never stored']
  avatar_emoji         text  [null]
  message_ttl_seconds  int   [null, note: 'Disappearing messages: stamps expires_at on rows sent AFTER the change']
  created_by           text  [null]
  created_at           text
  updated_at           text  [note: 'Bumped on every message — the list orders by it']
}
Ref: conversations.created_by > users.id

Table conversation_participants {
  conversation_id  text  [pk, note: 'Composite PK (conversation_id, user_id)']
  user_id          text  [pk]
  pinned           int   [default: 0, note: 'The list pin of the CALLER alone, per membership row']
  last_read_at     text  [null, note: 'Read store #1: drives unreadCount and the tab badge; only ever ADVANCES']
  joined_at        text  [note: 'App deletes the row on leave; last leaver purges the whole room']
}
Ref: conversation_participants.conversation_id > conversations.id
Ref: conversation_participants.user_id > users.id

Table messages {
  id               text  [pk, note: 'uuid4']
  conversation_id  text
  sender_id        text
  text             text  [note: 'Blanked on unsend']
  image_url        text  [null, note: 'Own /api/uploads/ or /api/memes/file/ path ONLY — the beacon guard']
  reply_to_id      text  [null, note: 'Self-reference; the quote follows edits and blanks on unsend']
  deleted_at       text  [null, note: 'SOFT delete ("unsend") — the row keeps its slot, content is cleared']
  client_msg_id    text  [null, note: 'The idempotency nonce of the sender — a retry answers the committed row']
  kind             text  [default: 'text', note: 'text / image / file / video / audio / system']
  edited_at        text  [null]
  attachment_url   text  [null]
  attachment_name  text  [null]
  attachment_size  int   [null]
  attachment_mime  text  [null]
  attachment_meta  text  [null, note: 'JSON: width/height/duration/thumbnailUrl/preview/waveform']
  link_preview     text  [null, note: 'JSON card the server unfurled — the picture is re-hosted as an own upload']
  gallery          text  [null, note: 'JSON list of 2-8 photos; rides alone, no single image/file beside it']
  pinned_at        text  [null]
  pinned_by        text  [null, note: 'Loose ref — the pinner is remembered even after they leave']
  forwarded        int   [default: 0]
  expires_at       text  [null, note: 'Partial index — the sweeps hard-delete overdue rows and their files']
  created_at       text  [note: 'NAIVE UTC — the paging cursor compares (created_at, id) as strings']

  indexes {
    (conversation_id, sender_id, client_msg_id) [unique, note: 'The idempotent-send index']
  }
}
Ref: messages.conversation_id > conversations.id
Ref: messages.sender_id > users.id
Ref: messages.reply_to_id > messages.id

Table message_reads {
  message_id  text  [pk, note: 'Composite PK (message_id, user_id) — read store #2: drives status and readBy']
  user_id     text  [pk]
  read_at     text
}
Ref: message_reads.message_id > messages.id
Ref: message_reads.user_id > users.id

Table message_reactions {
  message_id  text  [pk, note: 'Composite PK (message_id, user_id) — ONE emoji per person, replaced never accumulated']
  user_id     text  [pk]
  emoji       text  [note: 'One of the six picker emoji — server-side allowlist']
  created_at  text
}
Ref: message_reactions.message_id > messages.id
Ref: message_reactions.user_id > users.id


// ------------------------------------------------------------
// Timetable, handbook, memes (schedule / info / memes apps)
// ------------------------------------------------------------

Table schedule_lessons {
  id           text  [pk, note: 'uuid4 — but the IDENTITY is the natural key below']
  title        text
  teacher      text  [null, note: 'Scraper stores "" never NULL — NULLs count as distinct in the unique key']
  room         text  [null]
  time_start   text  [note: '"HH:MM" wall clock']
  time_end     text
  day_of_week  int   [note: 'CHECK 0..6, 0 = Monday']
  group_name   text  [null, note: 'Programme abbreviation + course, e.g. "ISKS-1"; parallel groups share it']
  semester     text  [null, note: '"YYYY-R" autumn / "YYYY-P" spring, keyed on the first calendar year of the academic year']
  created_at   text

  Note: 'UNIQUE over (semester, group_name, day_of_week, time_start, time_end, title, teacher, room) — the whole row IS the identity; the scraper rewrites the current semester partitions against it'
}

Table faculty_info {
  id          text  [pk, note: 'uuid4 — survives re-scrapes (the row is updated in place)']
  lang        text  [note: 'Only "lt" is ever scraped; "en" serves the curated handbook']
  section     text  [note: 'contacts / programs / general_contact']
  data_json   text  [note: 'The scraped JSON blob the API overlays on the curated handbook']
  scraped_at  text  [note: 'NAIVE UTC; the API drops sections older than 30 days']

  indexes {
    (lang, section) [unique]
  }
}

Table memes {
  id          text  [pk, note: 'uuid4']
  filename    text  [unique, note: '<32 hex>.<ext> in its own directory — chat may embed via /api/memes/file/']
  title       text
  tags        text  [null]
  added_by    text  [null, note: 'Pusher-or-admin may delete']
  byte_size   int
  width       int   [null]
  height      int   [null]
  preview     text  [null, note: 'Tiny data: URI blur-up']
  search      text  [null, note: 'Title+tags with Lithuanian diacritics folded to ASCII']
  created_at  text
}
Ref: memes.added_by > users.id


// ------------------------------------------------------------
// Admin console (admin app)
// ------------------------------------------------------------

Table admin_audit {
  id          text  [pk, note: 'uuid4']
  actor_id    text  [null, note: 'The trail outlives an erased admin account']
  action      text  [note: 'e.g. invitation.create, user.role, user.delete, notification.broadcast, report.status']
  target      text  [null, note: 'The acted-on id — loose ref across many tables']
  payload     text  [null, note: 'JSON context; written INSIDE the mutating transaction, on its own savepoint']
  created_at  text
}
Ref: admin_audit.actor_id > users.id


// ------------------------------------------------------------
// Scrapers (scraper app)
// ------------------------------------------------------------

Table scraper_runs {
  id              text  [pk, note: 'uuid4. A live "running" row IS the cross-process run lock (the conditional INSERT in open_run)']
  source          text  [note: 'knf.vu.lt / vu.lt / tvarkarasciai.vu.lt / knf.vu.lt/info']
  status          text  [note: 'CHECK: running / completed / failed; orphaned "running" rows are reconciled daily']
  articles_found  int   [default: 0, note: 'The column names come from the news scraper; every source reports through them']
  articles_new    int   [default: 0]
  error_message   text  [null, note: 'Truncated exception text — HTTP answers only the stable slug']
  started_at      text
  finished_at     text  [null]
}


// ------------------------------------------------------------
// Wayfind — the indoor map (wayfind app)
// Panorama/plan ids are the sha256 of the stored bytes;
// op and capture ids are scoped strings "<building>:<client id>"
// ------------------------------------------------------------

Table wf_buildings {
  id                  text  [pk, note: 'Lowercase slug, e.g. "knf" — carried by the app and every URL']
  name                text
  north_deg           real  [null]
  entrance_node_id    text  [null, note: 'Loose ref into the draft — may name a node not yet created']
  draft_revision      int   [default: 0, note: 'Bumped once per accepted op batch']
  published_revision  int   [null, note: 'Points at the wf_versions snapshot students fetch']
  created_at          text
  updated_at          text
}

Table wf_entities {
  building_id  text  [pk, note: 'Composite PK (building_id, kind, id)']
  kind         text  [pk, note: 'CHECK: level / node / edge / room']
  id           text  [pk, note: 'The editor-facing entity id']
  data         text  [note: 'The entity JSON — shape-checked on write, fully validated at publish']
  revision     int   [note: 'The draft revision this entity last changed in — what baseRevision conflicts and ?since deltas read']
  updated_at   text
  updated_by   text  [null]
  deleted      int   [default: 0, note: 'TOMBSTONE — the row stays so a ?since delta can carry the deletion']
}
Ref: wf_entities.building_id > wf_buildings.id

Table wf_ops {
  id           text  [pk, note: '"<building>:<client op id>" — idempotent PER BUILDING; a replay answers what the original did']
  building_id  text
  revision     int   [null, note: 'The revision an applied op landed at; NULL for rejected']
  op           text  [note: 'The op JSON verbatim — the audit trail']
  author_id    text  [null]
  status       text  [note: 'CHECK: applied / rejected']
  reason       text  [null, note: 'The rejection ("conflict", a shape error, ...)']
  created_at   text
}
Ref: wf_ops.building_id > wf_buildings.id

Table wf_versions {
  building_id   text  [pk, note: 'Composite PK (building_id, revision)']
  revision      int   [pk]
  document      text  [note: 'The published BuildingGraph JSON, byte-for-byte what the ETag hashes']
  etag          text  [note: 'sha256 of document — If-None-Match answers 304']
  note          text  [null]
  published_by  text  [null]
  published_at  text
}
Ref: wf_versions.building_id > wf_buildings.id

Table wf_panoramas {
  id               text  [pk, note: 'sha256 of the stored JPEG — content-addressed, served immutable; a re-upload answers the same id']
  building_id      text
  node_id          text  [null, note: 'Loose ref into the draft']
  width            int
  height           int
  bytes            int
  hfov_deg         real  [null]
  vfov_deg         real  [null]
  heading_raw_deg  real  [null]
  heading_source   text  [null, note: '"auto" for stitched panoramas']
  uploaded_by      text  [null]
  created_at       text
}
Ref: wf_panoramas.building_id > wf_buildings.id

Table wf_plans {
  id           text  [pk, note: 'sha256 of the SANITISED SVG text (scripts stripped before hashing)']
  building_id  text
  level_id     text  [null, note: 'Loose ref into the draft']
  bytes        int
  uploaded_by  text  [null]
  created_at   text
}
Ref: wf_plans.building_id > wf_buildings.id

Table wf_captures {
  id              text  [pk, note: '"<building>:<client capture id>" — the bare id resolves while unique, ambiguity answers 409']
  building_id     text
  node_id         text  [null]
  mode            text  [note: 'CHECK: full / walls']
  frame_hfov_deg  real
  targets         text  [note: 'The aiming plan of the client, stored verbatim as JSON']
  expected        int   [note: 'len(targets)']
  status          text  [note: 'CHECK: uploading / queued / stitching / done / failed — the conditional queued→stitching UPDATE is the claim of the worker']
  progress_pct    int   [default: 0]
  report          text  [null, note: 'JSON: coverage + timing on done, the reason on failed, the parked centreYawDeg between finish and stitch']
  pano_id         text  [null, note: 'The stitched wf_panoramas id — loose ref']
  created_by      text  [null]
  created_at      text
  updated_at      text
}
Ref: wf_captures.building_id > wf_buildings.id

Table wf_capture_frames {
  capture_id  text  [pk, note: 'Composite PK (capture_id, target_id) — a re-shot target REPLACES its row and file']
  target_id   text  [pk]
  yaw_deg     real  [note: 'The tracker pose at the shutter: yaw clockwise from above']
  pitch_deg   real  [note: 'Positive up, within ±90']
  roll_deg    real  [note: 'Positive = tilted clockwise from upright portrait']
  bytes       int
  width       int
  height      int
  updated_at  text  [note: 'Earliest updated_at gives the stitcher its fallback centre column']
}
Ref: wf_capture_frames.capture_id > wf_captures.id


// ------------------------------------------------------------
// Groups
// ------------------------------------------------------------

TableGroup "Accounts & Sessions" {
  users
  invitation_codes
  sessions
}

TableGroup "Push Delivery" {
  push_tokens
  notification_channels
}

TableGroup "Stored Files" {
  uploads
  memes
}

TableGroup "News & Polls" {
  news_posts
  news_likes
  news_comments
  polls
  poll_options
  poll_votes
  deleted_source_urls
}

TableGroup "Social" {
  friendships
  friend_requests
  user_blocks
  reports
  activity
}

TableGroup "Chat" {
  conversations
  conversation_participants
  messages
  message_reads
  message_reactions
}

TableGroup "Timetable & Handbook" {
  schedule_lessons
  faculty_info
}

TableGroup "Admin & Scrapers" {
  admin_audit
  scraper_runs
}

TableGroup "Wayfind (indoor map)" {
  wf_buildings
  wf_entities
  wf_ops
  wf_versions
  wf_panoramas
  wf_plans
  wf_captures
  wf_capture_frames
}
